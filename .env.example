# Environment variables for local development
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Sherqilla/110
DB_NAME=manage_money
DB_SSL=false

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_required
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
MOBILE_DEEP_LINK=managemoney://auth/callback

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
