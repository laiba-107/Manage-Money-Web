{
  "version": 2,
  "buildCommand": "cd backend && npm run build",
  "outputDirectory": "backend/dist",
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "frontend/**",
          "backend/public/**",
          "backend/dist/public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "backend/api/index.ts"
    }
  ]
}
