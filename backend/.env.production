# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# IMPORTANT: Never commit this file to version control!
# Copy this file to .env and fill in the real values.

NODE_ENV=production
PORT=3000
API_VERSION=v1

# PostgreSQL - Use connection pooling service in production (e.g., PgBouncer)
DB_HOST=your-production-db-host.amazonaws.com
DB_PORT=5432
DB_USERNAME=manage_money_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=manage_money
DB_SSL=true

# JWT - Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

# Frontend
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Mobile app deep link
MOBILE_DEEP_LINK=managemoney://auth/callback

# Rate limiting (production values)
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Logging
LOG_LEVEL=warn
LOG_DIR=/app/logs

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/app/uploads
